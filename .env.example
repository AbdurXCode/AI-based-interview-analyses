# Copy to `backend/.env` or repo-root `.env` (both are loaded by the backend).
# Never commit real secrets.

# ── Required for auth + DB in normal dev ─────────────────────────────────────
JWT_SECRET=change-me-use-openssl-rand-hex-32-in-real-deploys
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/interview_prep

# ── AI (mock interview / resume) ─────────────────────────────────────────────
GEMINI_API_KEY=

# Optional: Vertex / ADK JSON path (see backend/src/ai_interview_analysis/core/settings.py)
# GCP_PROJECT_ID=
# VERTEX_AI_LOCATION=us-central1

# Optional OpenAPI legacy route
# OPENAI_API_KEY=

# ── Feature flags ────────────────────────────────────────────────────────────
# FEATURE_VIDEO_ANALYSIS=0
# USE_OPENAI_LEGACY_ANSWER_SUGGESTIONS=0

# ── CORS (comma-separated origins) ───────────────────────────────────────────
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Storage ──────────────────────────────────────────────────────────────────
# STORAGE_BACKEND=local
# GCS_BUCKET_UPLOADS=
